# Tower Tracker settings. Copy this file to .env (same folder as docker-compose.yml), edit it,
# then recreate the container:  docker compose up -d
# (.env is read by Docker Compose; it is never copied into the image.)

# Which version to run: "beta" follows the newest beta, or pin one like 0.8.0. After 1.0 the stable
# channel is "latest". Update with: docker compose pull && docker compose up -d
TT_VERSION=beta

# Port to open the app on, e.g. http://tower:8080. Used both on Unraid and inside the container.
PORT=8080

# Where the database and attachments live on the Unraid host. Use the pool path rather than
# /mnt/user/... while "Permit exclusive shares" is off: SQLite shouldn't go through Unraid's
# user-share layer. Change "cache" if your pool has another name.
DATA_PATH=/mnt/cache/appdata/tower-tracker

# Time zone for all dates and times in the app.
TZ=America/Chicago

# Owner of the files in DATA_PATH (Unraid default: nobody:users = 99:100).
PUID=99
PGID=100

# Largest attachment allowed, in MB.
MAX_UPLOAD_MB=25

# Optional. If set, this is the password and it can't be changed in the app. If empty, the
# container log prints a one-time setup code on first start and you choose the password in the
# browser. Put it in single quotes if it contains a $ sign.
APP_PASSWORD=

# Only if Nginx Proxy Manager proxies this app: the NPM VM's LAN IP, e.g. 192.168.1.20.
# Never "true" (that would let anyone fake their IP and dodge the login rate limit).
TRUST_PROXY=

# Optional. An Anthropic API key (console.anthropic.com) turns on Add ticket → "Describe the
# issue": Claude drafts the ticket (priority, severity, details, checklist) for you to review.
# Only the text you type and your label names are sent. Empty = fully offline, and Add ticket
# offers the paste-JSON import instead. Put it in single quotes if it contains a $ sign.
ANTHROPIC_API_KEY=
